            lines.append(f"  {sid:<{col}}  {with_reverts[sid]['external_write_revert_count']:>13}")
    lines.append("")
    lines.append(
        "  strike_count and external_write_revert_count are implemented.\n"
        "  re-clarification-loop and rework-commit signals are NOT computed —\n"
