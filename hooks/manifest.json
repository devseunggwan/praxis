{
  "$schema": "./manifest.schema.json",
  "description": "praxis hooks: Stop gate for completion-without-evidence, completion-signal phrase advisory (no-evidence-block), retrospect memory-bias gate, session-scoped three-strike discipline, PreToolUse(Bash) side-effect scan / gh search --state all block / memory-hint / caller-chain evidence gate on gh pr create / pre-commit evidence gate on gh pr create / pre-merge approval gate / cross-boundary pre-flight (heredoc block + cross-repo ask) / momentum-rule-retrieval-gate (gh pr merge / cmux dispatch / force-push), PreToolUse(AskUserQuestion) end-option mechanical-transcribe advisory + manufactured action-menu continuation guard, PostToolUse correction for built-in task management tools, UserPromptSubmit codex-review worktree disambiguation",
  "dispatch_groups": [
    {
      "event": "PreToolUse",
      "matcher": "Bash"
    }
  ],
  "hooks": [
    {
      "name": "strike-counter",
      "role": "completion-verify",
      "body": "impl.sh",
      "event": "SessionStart",
      "args": [
        "session-start"
      ],
      "timeout": 5,
      "mode": {
        "state_paths": ["PRAXIS_STATE_DIR"]
      }
    },
    {
      "name": "strike-counter",
      "role": "completion-verify",
      "body": "impl.sh",
      "event": "UserPromptSubmit",
      "args": [
        "preprompt"
      ],
      "timeout": 5
    },
    {
      "name": "codex-review-route",
      "role": "advisory-nudge",
      "body": "impl.sh",
      "event": "UserPromptSubmit",
      "hosts": [
        "claude"
      ],
      "timeout": 5
    },
    {
      "name": "session-intent",
      "role": "preflight-gate",
      "event": "UserPromptSubmit",
      "timeout": 5,
      "mode": {
        "state_paths": [
          "PRAXIS_SESSION_INTENT_FILE"
        ]
      }
    },
    {
      "name": "retrospect-active-marker",
      "role": "preflight-gate",
      "event": "UserPromptSubmit",
      "timeout": 5
    },
    {
      "name": "retrospect-active-marker",
      "role": "preflight-gate",
      "event": "PreToolUse",
      "matcher": "Skill",
      "timeout": 5
    },
    {
      "name": "postcompact-context",
      "role": "advisory-nudge",
      "event": "UserPromptSubmit",
      "hosts": [
        "claude"
      ],
      "timeout": 8,
      "mode": {
        "bypass_env": [
          "PRAXIS_HOOK_BYPASS_POSTCOMPACT_CONTEXT"
        ],
        "state_paths": [
          "PRAXIS_POSTCOMPACT_CONTEXT_FILE",
          "PRAXIS_POSTCOMPACT_TAIL_LINES"
        ]
      }
    },
    {
      "name": "side-effect-scan",
      "role": "preflight-gate",
      "event": "PreToolUse",
      "matcher": "Bash",
      "timeout": 5
    },
    {
      "name": "block-gh-state-all",
      "role": "preflight-gate",
      "event": "PreToolUse",
      "matcher": "Bash",
      "timeout": 5
    },
    {
      "name": "foreground-poll-loop-guard",
