# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Planning files (user-specific)
task_plan.md
notes.md
research_notes.md

# Logs & temp
*.log
tmp/

# Python
__pycache__/
*.pyc

# OMC (oh-my-claudecode local state)
.omc/
.omx/

# Runtime wrappers generated from hooks/manifest.json (ADR-0001 §2.3 / Phase 2).
# scripts/build-plugin-manifests.py rewrites these on every build. Only
# top-level wrappers under hooks/ are generated; per-hook impls live at
# hooks/<role>/<name>/impl.{py,sh} and remain tracked.
hooks/*.sh
!hooks/manifest.json
